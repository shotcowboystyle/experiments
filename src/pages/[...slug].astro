---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { getCollection, render } from "astro:content";

import ArrowLeft from "@lucide/astro/icons/arrow-left";
import Maximize from "@lucide/astro/icons/maximize";
import Minimize from "@lucide/astro/icons/minimize";
import Moon from "@lucide/astro/icons/moon";
import PanelLeft from "@lucide/astro/icons/panel-left";
import Sun from "@lucide/astro/icons/sun";

import Base from "~/layouts/Base.astro";
import { posterPath } from "~/lib/poster";
import { sortByDate } from "~/lib/sort-by-date";
import { withBase } from "~/lib/with-base";

export const getStaticPaths = async () => {
  const experiments = await getCollection("experiments");
  return experiments.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const all = sortByDate(await getCollection("experiments"));

// The demo is a sibling `.astro` named in frontmatter, so the stage can show
// it alone and keep the prose for the info panel.
const demos = import.meta.glob<{ default: AstroComponentFactory }>(
  "/src/content/experiments/*/*.astro",
);
const demoPath = entry.data.demo && `/src/content/experiments/${entry.id}/${entry.data.demo.replace(/^\.\//u, "")}`;
const demoModule = demoPath ? await demos[demoPath]() : undefined;
const Demo = demoModule?.default;
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  image={posterPath(entry.id)}
  pubDate={entry.data.pubDate}
>
  <div class="shell" data-view={Demo ? "stage" : "split"}>
    <div class="dock dock-start">
      <a class="ctl" href={withBase("/")} aria-label="Back to experiments">
        <ArrowLeft aria-hidden="true" size={16} />
      </a>
      <button class="ctl" popovertarget="nav" aria-label="Browse experiments">
        <PanelLeft aria-hidden="true" size={16} />
      </button>
    </div>
    <nav id="nav" class="nav" popover aria-label="Experiments">
      <a class="nav-link nav-all" href="/">← shotcowboystyle</a>
      <a class="nav-link nav-all" href={withBase("/")}>All experiments</a>
      <ol role="list">
        {
          all.map((e) => (
            <li>
              <a class="nav-link" href={withBase(`/${e.id}/`)} aria-current={e.id === entry.id ? "page" : undefined}>
                {e.data.title}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="dock dock-end">
      <button class="ctl" id="info-toggle" aria-pressed="false" aria-controls="info" aria-label="Details">
        <Minimize aria-hidden="true" size={16} />
      </button>
      <button class="ctl" id="fullscreen" aria-label="Fullscreen">
        <Maximize aria-hidden="true" size={16} />
      </button>
      <button class="ctl scheme" id="scheme" role="switch" aria-checked="false" aria-label="Dark mode">
        <Sun class="scheme-light" aria-hidden="true" size={16} />
        <Moon class="scheme-dark" aria-hidden="true" size={16} />
      </button>
    </div>

    <main class="stage" id="stage">{Demo && <Demo />}</main>

    <aside class="info" id="info">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={withBase("/")}>Experiments</a>
        <span class="crumb-dot" aria-hidden="true"></span>
        <span>{entry.data.title}</span>
      </nav>
      <h1 class="info-title">{entry.data.title}</h1>
      {entry.data.description && <p class="info-lede">{entry.data.description}</p>}
      <div class="page-main"><Content /></div>
    </aside>
  </div>
</Base>

<script>
  const shell = document.querySelector<HTMLElement>(".shell");
  const stage = document.querySelector<HTMLElement>("#stage");
  const info = document.querySelector<HTMLButtonElement>("#info-toggle");
  const panel = document.querySelector<HTMLElement>("#info");
  // Below the split breakpoint the panel opens under the fold; matches the CSS.
  const narrow = matchMedia("(width < 64rem)");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");

  info?.addEventListener("click", () => {
    if (!shell) {
      return;
    }
    const split = shell.dataset.view !== "split";
    shell.dataset.view = split ? "split" : "stage";
    info.setAttribute("aria-pressed", String(split));
    if (split && narrow.matches) {
      panel?.scrollIntoView({ behavior: reduced.matches ? "auto" : "smooth" });
    }
  });

  // An inline `color-scheme` on :root is what Shift and our light-dark() tokens
  // key off; leaving it unset follows the OS.
  const root = document.documentElement;
  const scheme = document.querySelector<HTMLButtonElement>("#scheme");
  const osDark = matchMedia("(prefers-color-scheme: dark)");
  const isDark = () => (root.style.colorScheme || (osDark.matches ? "dark" : "light")) === "dark";
  const syncScheme = () => scheme?.setAttribute("aria-checked", String(isDark()));

  syncScheme();
  osDark.addEventListener("change", syncScheme);
  scheme?.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    root.style.colorScheme = next;
    syncScheme();
    try {
      localStorage.setItem("color-scheme", next);
    } catch {
      // Safe to continue: the choice still holds for this page, it just won't persist.
    }
  });

  // ponytail: iOS Safari has no element requestFullscreen; button is a no-op there.
  document.querySelector("#fullscreen")?.addEventListener("click", () => {
    if (document.fullscreenElement) {
      document.exitFullscreen();
    } else {
      stage?.requestFullscreen?.();
    }
  });
</script>

<style>
  .shell {
    min-height: 100dvh;
  }

  /* ---- Stage ---- */

  .stage {
    display: grid;
    min-height: 100dvh;
    padding: var(--s-space-2);
    /* Width stays auto and follows the margin; `auto` can't be interpolated,
       so animating width directly would snap. */
    transition: margin-left 300ms ease-in-out;
  }

  .stage :global(.demo) {
    min-height: calc(100dvh - var(--s-space-4));
    margin: 0;
  }

  /* Narrow split: the panel sits under the stage, so let its top peek above
     the fold as a cue that there is more to read. */
  @media (width < 64rem) {
    [data-view="split"] .stage,
    [data-view="split"] .stage :global(.demo) {
      min-height: 75dvh;
    }
  }

  .stage:fullscreen {
    background: var(--s-surface-base);
  }

  .stage:fullscreen :global(.demo) {
    min-height: 100%;
    border-radius: 0;
  }

  /* ---- Info panel ---- */

  .info {
    padding: var(--s-space-10) var(--s-space-6) var(--s-space-24);
  }

  [data-view="stage"] .info {
    display: none;
  }

  /* Panel stays fixed in both views so it slides out in place instead of
     dropping into the flow while it leaves. Left gutter clears the left dock. */
  @media (width >= 64rem) {
    [data-view="split"] .stage {
      margin-left: 50%;
    }

    .info {
      position: fixed;
      inset: 0 50% 0 0;
      overflow-y: auto;
      padding-inline: var(--s-space-32) var(--s-space-10);
    }
  }

  @media (width >= 64rem) and (prefers-reduced-motion: no-preference) {
    .info {
      transition:
        translate 300ms ease-in-out,
        display 300ms allow-discrete;

      @starting-style {
        translate: -100% 0;
      }
    }

    [data-view="stage"] .info {
      translate: -100% 0;
    }
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: var(--s-space-2);
    color: var(--page-muted);
    font-weight: 500;
    font-size: 0.875rem;
    letter-spacing: -0.01em;

    a {
      color: inherit;
      text-decoration: none;

      &:hover {
        color: var(--page-ink);
      }
    }
  }

  .crumb-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
  }

  .info-title {
    margin: var(--s-space-8) 0 0;
    color: var(--page-ink);
    font-weight: 700;
    font-size: 2.25rem;
    line-height: 2.5rem;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .info-lede {
    max-width: 65ch;
    margin: var(--s-space-4) 0 var(--s-space-8);
    color: var(--page-muted);
    font-size: 1.125rem;
    line-height: 1.75rem;
    text-wrap: pretty;
  }

  /* ---- Dock + controls ---- */

  .dock {
    position: fixed;
    top: 24px;
    z-index: 99;
    border-radius: 16px;
    background: var(--page-stage);
    box-shadow: var(--page-halo);
    outline: var(--page-edge);
    user-select: none;
  }

  .dock {
    display: flex;
    gap: 4px;
    padding: 6px;
  }

  .dock-start {
    left: 24px;
  }

  .dock-end {
    right: 24px;
  }

  .ctl {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: color-mix(in oklch, var(--page-ink) 6%, transparent);
    color: var(--page-ink);
    cursor: pointer;
    transition:
      scale 150ms ease-in-out,
      background-color 150ms ease-in-out,
      color 150ms ease-in-out;

    &:hover {
      background: color-mix(in oklch, var(--page-ink) 10%, transparent);
    }

    &:active {
      scale: 0.95;
    }

    &[aria-pressed="true"] {
      background: color-mix(in oklch, var(--s-interactive-primary) 15%, transparent);
      color: var(--s-interactive-primary);
    }

    &:focus-visible {
      outline: 2px solid var(--s-interactive-primary);
      outline-offset: 2px;
    }
  }

  .scheme[aria-checked="true"] .scheme-light,
  .scheme[aria-checked="false"] .scheme-dark {
    display: none;
  }

  /* Tooltip reads the accessible name, so the two never drift apart. */
  .dock .ctl {
    position: relative;

    &::after {
      content: attr(aria-label);
      position: absolute;
      top: calc(100% + 12px);
      left: 50%;
      padding: 4px 8px;
      border-radius: 8px;
      background: var(--page-ink);
      color: var(--page-stage);
      font-size: 12px;
      line-height: 16px;
      white-space: nowrap;
      pointer-events: none;
      opacity: 0;
      translate: -50% -4px;
      transition:
        opacity 150ms ease-out,
        translate 150ms ease-out;
    }

    &:focus-visible::after {
      opacity: 1;
      translate: -50% 0;
    }

    @media (hover: hover) {
      &:hover::after {
        opacity: 1;
        translate: -50% 0;
      }
    }
  }

  /* Centred, "Back to experiments" would spill off the left edge; hang the
     left dock's tooltips from their control's left edge instead. */
  .dock-start .ctl::after {
    left: 0;
    translate: 0 -4px;
  }

  .dock-start .ctl:focus-visible::after {
    translate: 0 0;
  }

  @media (hover: hover) {
    .dock-start .ctl:hover::after {
      translate: 0 0;
    }
  }

  /* ---- Drawer ---- */

  .nav {
    position: fixed;
    inset: 8px auto 8px 8px;
    width: min(320px, calc(100vw - 16px));
    margin: 0;
    padding: var(--s-space-8) var(--s-space-5);
    overflow-y: auto;
    border: 0;
    border-radius: 24px;
    background: var(--page-stage);
    color: var(--page-ink);
    outline: var(--page-edge);
    outline-offset: -1px;

    &::backdrop {
      background: color-mix(in oklch, var(--page-ink) 20%, transparent);
    }

    ol {
      margin: var(--s-space-6) 0 0;
      padding: 0;
      list-style: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav {
      translate: -100% 0;
      transition:
        translate 300ms ease-in-out,
        display 300ms allow-discrete,
        overlay 300ms allow-discrete;

      &:popover-open {
        translate: 0 0;

        @starting-style {
          translate: -100% 0;
        }
      }
    }
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-block: 10px;
    color: var(--page-ink);
    font-size: 15px;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    opacity: 0.4;
    transition:
      opacity 150ms ease-out,
      color 150ms ease-out;

    &::before {
      content: "";
      flex: none;
      width: 32px;
      height: 1px;
      background: currentColor;
    }

    &:hover,
    &[aria-current="page"] {
      color: var(--s-interactive-primary);
      opacity: 1;
    }

    &:focus-visible {
      outline: 2px solid var(--s-interactive-primary);
      outline-offset: 2px;
    }
  }

  .nav-all {
    opacity: 1;
  }
</style>
