<script is:inline>
  // Pre-paint gate. With JavaScript, only the first grid shows until the
  // tabs take over, and cards stay hidden until motion takes over. The
  // recovery timer is armed first so a blocked bundle still leaves both
  // grids readable; without JavaScript nothing is ever hidden.
  (() => {
    const root = document.documentElement;
    window.__ebgBootTimer = setTimeout(() => {
      if (root.dataset.ebgBoot === "pending") {
        root.dataset.ebgBoot = "recovered";
      }
    }, 2500);
    root.dataset.ebgMotion = matchMedia("(prefers-reduced-motion: reduce)").matches ? "reduced" : "full";
    root.dataset.ebgBoot = "pending";
  })();
</script>

